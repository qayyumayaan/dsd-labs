initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module top_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [7:0] SW_x0;
reg [7:0] SW_x1;
reg clk;
reg rst_n;
// wires                                               
wire [6:0] HEX0;
wire [6:0] HEX1;
wire [6:0] HEX2;
wire [6:0] HEX3;
wire [6:0] HEX4;
wire [6:0] HEX5;

wire sampler;                             

// assign statements (if any)                          
top i1 (
// port map - connection between master ports and signals/registers   
	.HEX0(HEX0),
	.HEX1(HEX1),
	.HEX2(HEX2),
	.HEX3(HEX3),
	.HEX4(HEX4),
	.HEX5(HEX5),
	.SW_x0(SW_x0),
	.SW_x1(SW_x1),
	.clk(clk),
	.rst_n(rst_n)
);

// clk
always
begin
	clk = 1'b0;
	clk = #5000 1'b1;
	#5000;
end 

// rst_n
initial
begin
	rst_n = 1'b1;
	rst_n = #10000 1'b0;
	rst_n = #20000 1'b1;
end 
// SW_x1[ 7 ]
initial
begin
	SW_x1[7] = 1'b0;
end 
// SW_x1[ 6 ]
initial
begin
	SW_x1[6] = 1'b0;
end 
// SW_x1[ 5 ]
initial
begin
	SW_x1[5] = 1'b0;
end 
// SW_x1[ 4 ]
initial
begin
	SW_x1[4] = 1'b0;
	SW_x1[4] = #220000 1'b1;
	SW_x1[4] = #100000 1'b0;
	SW_x1[4] = #10000 1'b1;
end 
// SW_x1[ 3 ]
initial
begin
	SW_x1[3] = 1'b1;
	SW_x1[3] = #130000 1'b0;
	SW_x1[3] = #10000 1'b1;
	SW_x1[3] = #70000 1'b0;
	SW_x1[3] = #10000 1'b1;
	SW_x1[3] = #100000 1'b0;
end 
// SW_x1[ 2 ]
initial
begin
	SW_x1[2] = 1'b1;
	SW_x1[2] = #130000 1'b0;
	SW_x1[2] = #10000 1'b1;
	SW_x1[2] = #70000 1'b0;
	SW_x1[2] = #10000 1'b1;
	SW_x1[2] = #100000 1'b0;
end 
// SW_x1[ 1 ]
initial
begin
	SW_x1[1] = 1'b1;
	SW_x1[1] = #130000 1'b0;
	SW_x1[1] = #10000 1'b1;
	SW_x1[1] = #70000 1'b0;
	SW_x1[1] = #10000 1'b1;
	SW_x1[1] = #100000 1'b0;
end 
// SW_x1[ 0 ]
initial
begin
	SW_x1[0] = 1'b0;
end 
// SW_x0[ 7 ]
initial
begin
	SW_x0[7] = 1'b0;
end 
// SW_x0[ 6 ]
initial
begin
	SW_x0[6] = 1'b0;
end 
// SW_x0[ 5 ]
initial
begin
	SW_x0[5] = 1'b0;
	SW_x0[5] = #330000 1'b1;
end 
// SW_x0[ 4 ]
initial
begin
	SW_x0[4] = 1'b1;
	SW_x0[4] = #130000 1'b0;
	SW_x0[4] = #10000 1'b1;
	SW_x0[4] = #70000 1'b0;
	SW_x0[4] = #10000 1'b1;
	SW_x0[4] = #100000 1'b0;
end 
// SW_x0[ 3 ]
initial
begin
	SW_x0[3] = 1'b1;
	SW_x0[3] = #130000 1'b0;
	SW_x0[3] = #10000 1'b1;
	SW_x0[3] = #70000 1'b0;
	SW_x0[3] = #10000 1'b1;
	SW_x0[3] = #100000 1'b0;
	SW_x0[3] = #10000 1'b1;
end 
// SW_x0[ 2 ]
initial
begin
	SW_x0[2] = 1'b1;
	SW_x0[2] = #130000 1'b0;
	SW_x0[2] = #10000 1'b1;
	SW_x0[2] = #70000 1'b0;
	SW_x0[2] = #10000 1'b1;
	SW_x0[2] = #100000 1'b0;
	SW_x0[2] = #10000 1'b1;
end 
// SW_x0[ 1 ]
initial
begin
	SW_x0[1] = 1'b1;
	SW_x0[1] = #130000 1'b0;
	SW_x0[1] = #10000 1'b1;
	SW_x0[1] = #70000 1'b0;
	SW_x0[1] = #10000 1'b1;
	SW_x0[1] = #100000 1'b0;
end 
// SW_x0[ 0 ]
initial
begin
	SW_x0[0] = 1'b1;
	SW_x0[0] = #130000 1'b0;
end 

top_vlg_sample_tst tb_sample (
	.SW_x0(SW_x0),
	.SW_x1(SW_x1),
	.clk(clk),
	.rst_n(rst_n),
	.sampler_tx(sampler)
);

top_vlg_check_tst tb_out(
	.HEX0(HEX0),
	.HEX1(HEX1),
	.HEX2(HEX2),
	.HEX3(HEX3),
	.HEX4(HEX4),
	.HEX5(HEX5),
	.sampler_rx(sampler)
);
endmodule

