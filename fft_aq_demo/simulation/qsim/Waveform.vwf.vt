`timescale 1 ps/ 1 ps
module top_vlg_sample_tst(
	SW_x0,
	SW_x1,
	clk,
	rst_n,
	sampler_tx
);
input [7:0] SW_x0;
input [7:0] SW_x1;
input  clk;
input  rst_n;
output sampler_tx;

reg sample;
time current_time;
always @(SW_x0 or SW_x1 or clk or rst_n)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
    if ($realtime == 0 || $realtime != current_time)  
    begin                                             
        if (sample === 1'bx)                          
            sample = 0;                               
        else                                          
            sample = ~sample;                         
    end                                               
    current_time = $realtime;                         
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

