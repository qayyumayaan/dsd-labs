module top (
    input logic [15:0] SW,             // 16 slide switches
    output logic [6:0] HEX0, HEX1, HEX2,  // 7-segment displays for X0
    output logic [6:0] HEX3, HEX4, HEX5   // 7-segment displays for X1
);

    // Split the switches into two 8-bit inputs
    logic signed [7:0] x0, x1;
    assign x0 = SW[7:0];    // Lower 8 switches for x0
    assign x1 = SW[15:8];   // Upper 8 switches for x1

    // FFT outputs
    logic signed [8:0] X0, X1; // Use signed 9 bits for output to account for overflow

    // Compute the FFT
    assign X0 = x0 + x1;    // Frequency 0
    assign X1 = x0 - x1;    // Frequency 1

    // Convert X0 and X1 to absolute values and prepare for decimal display
    logic [31:0] abs_X0, abs_X1; // Unsigned values for display
    assign abs_X0 = (X0 < 0) ? -X0 : X0;
    assign abs_X1 = (X1 < 0) ? -X1 : X1;

    // Instantiate the display driver for X0 (HEX0, HEX1, HEX2)
    display display_X0_0(.data_in(abs_X0[3:0]),   .segments(HEX0)); // Ones place
    display display_X0_1(.data_in(abs_X0[7:4]),   .segments(HEX1)); // Tens place
    display display_X0_2(.data_in(abs_X0[11:8]),  .segments(HEX2)); // Hundreds place

    // Instantiate the display driver for X1 (HEX3, HEX4, HEX5)
    display display_X1_0(.data_in(abs_X1[3:0]),   .segments(HEX3)); // Ones place
    display display_X1_1(.data_in(abs_X1[7:4]),   .segments(HEX4)); // Tens place
    display display_X1_2(.data_in(abs_X1[11:8]),  .segments(HEX5)); // Hundreds place

endmodule